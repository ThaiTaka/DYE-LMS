{
  "name": "@dye/judge-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "verify-seed": "tsx src/verify-seed.ts",
    "images": "docker build -t dye-judge-pytest:3.12 -f images/pytest.Dockerfile images"
  },
  "dependencies": {
    "@dye/core": "*",
    "@dye/db": "*",
    "@prisma/client": "^6.2.1",
    "bullmq": "^5.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
