{
  "name": "@dye/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "node prisma/chay-voi-env.mjs prisma migrate deploy",
    "db:migrate:dev": "node prisma/chay-voi-env.mjs prisma migrate dev",
    "db:seed": "node prisma/chay-voi-env.mjs prisma db seed",
    "db:verify": "node prisma/chay-voi-env.mjs tsx prisma/seed/verify.ts",
    "db:reset": "node prisma/chay-voi-env.mjs prisma migrate reset --force",
    "db:studio": "node prisma/chay-voi-env.mjs prisma studio",
    "build": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma --max-warnings 0",
    "test": "vitest run",
    "db:admin": "node prisma/chay-voi-env.mjs tsx prisma/scripts/tao-quan-tri.ts",
    "db:demo": "node prisma/chay-voi-env.mjs --dat SEED_DEMO=yes prisma db seed",
    "db:status": "node prisma/chay-voi-env.mjs prisma migrate status"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@node-rs/argon2": "^2.0.2"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
