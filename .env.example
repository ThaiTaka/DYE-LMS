# ─────────────────────────────────────────────────────────────────────────────
# DYE LMS — environment template
# Copy to `.env` and adjust. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# NODE_ENV is IGNORED when read from this file — scripts/moi-truong.mjs skips it
# on purpose. The value belongs to the tool being run: `next dev` sets
# development, `next build` sets production. Honouring it here once handed a
# production build the string "development", which selects the dev
# Content-Security-Policy and ships `unsafe-eval` to real users.
# Kept only because `docker compose` reads this file directly for the container
# environment, where it IS the right way to set it.
NODE_ENV=development

# ── Running the dev server on a remote box (VPS, LAN) ────────────────────────
# Next 15 rejects cross-origin requests to its internal /_next/* endpoints from
# an origin it was not told about. On localhost this never fires; reached by
# public IP or domain it silently serves a page with no styles and no Fast
# Refresh. Comma-separated, dev-only — `next start` ignores it. Leave empty for
# local work.
DEV_ORIGINS=

# ── Host port mappings ───────────────────────────────────────────────────────
# Offset from the defaults so they do not collide with services you may already
# run locally. Change freely; only the host side is affected.
POSTGRES_PORT=5442
REDIS_PORT=6389
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
WEB_PORT=3000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=dye
POSTGRES_PASSWORD=dye_dev_password_change_me
POSTGRES_DB=dye_lms

# Used by the host (npm run db:*). Matches POSTGRES_PORT above.
DATABASE_URL=postgresql://dye:dye_dev_password_change_me@localhost:5442/dye_lms?schema=public
# Used from inside the compose network (service name, internal port).
DATABASE_URL_DOCKER=postgresql://dye:dye_dev_password_change_me@postgres:5432/dye_lms?schema=public

# ── Redis (BullMQ queues + rate limiting) ────────────────────────────────────
REDIS_URL=redis://localhost:6389
REDIS_URL_DOCKER=redis://redis:6379

# ── MinIO / S3 (Pygame project assets, pygbag build artifacts) ───────────────
S3_ENDPOINT=http://localhost:9010
S3_ENDPOINT_DOCKER=http://minio:9000
S3_ACCESS_KEY=dye_minio_admin
S3_SECRET_KEY=dye_minio_dev_password_change_me
S3_BUCKET=dye-projects
S3_REGION=us-east-1

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace_me_with_a_32_byte_base64_secret
# ── AUTH_URL: leave this UNSET unless you have a fixed hostname ──────────────
# Auth.js reads it in `createActionURL` BEFORE looking at any header:
#
#     const envUrl = envObject.AUTH_URL ?? envObject.NEXTAUTH_URL;
#     if (envUrl) { url = new URL(envUrl) }   // wins outright
#     else { detectedHost = x-forwarded-host ?? host }
#
# So while it is set, AUTH_TRUST_HOST below has no effect and every auth redirect
# is pinned to this hostname. Behind a Cloudflare quick tunnel — new hostname on
# every restart — that sends users to a host that no longer resolves.
#
# Unset, the origin is taken from the request, so the app works on localhost, on
# a tunnel, and behind a proxy without being reconfigured.
# AUTH_URL=

# Trust x-forwarded-host / x-forwarded-proto. Required behind a tunnel or proxy.
AUTH_TRUST_HOST=true

# ── Seed ─────────────────────────────────────────────────────────────────────
# Password given to every demo account. Development only.
SEED_DEMO_PASSWORD=DyeLms#2026
# The seed refuses to run when NODE_ENV=production unless this is exactly "yes".
SEED_ALLOW_PRODUCTION=no

# ── Judge engine ─────────────────────────────────────────────────────────────
JUDGE_CONCURRENCY=4
JUDGE_MAX_PER_STUDENT=1
JUDGE_DEFAULT_TIME_LIMIT_MS=2000
JUDGE_DEFAULT_MEMORY_LIMIT_MB=256
JUDGE_OUTPUT_LIMIT_BYTES=262144

# Ceilings the worker enforces regardless of what a Problem row asks for.
# A bad value in authored data must not be able to hand a container the machine.
JUDGE_MAX_MEMORY_MB=256
JUDGE_MAX_TIME_MS=10000
# Grace added to a problem's time limit before the host kills the container.
JUDGE_KILL_GRACE_MS=1000
# How often the worker re-enqueues submissions that never reached the queue.
JUDGE_SWEEP_MS=60000
# Feature flag: pygbag/WASM browser preview for Pygame projects.
# Off by default — Project Upload + teacher review is the primary path.
FEATURE_PYGBAG_PREVIEW=false

# ── Tài khoản quản trị gốc ───────────────────────────────────────────────────
# Bộ seed tạo đúng một tài khoản này, và không tạo giáo viên / học sinh / lớp nào.
# Tên đăng nhập luôn lưu ở dạng chữ thường; gõ hoa hay thường khi đăng nhập đều được.
ADMIN_USERNAME=thaitaka
ADMIN_DISPLAY_NAME=Quản Trị Viên
# Ít nhất 12 ký tự. ĐỔI giá trị này trước khi chạy seed.
ADMIN_PASSWORD=DoiMatKhauNay#2026
