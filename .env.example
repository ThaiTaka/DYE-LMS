# ─────────────────────────────────────────────────────────────────────────────
# DYE LMS — environment template
# Copy to `.env` and adjust. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Host port mappings ───────────────────────────────────────────────────────
# Offset from the defaults so they do not collide with services you may already
# run locally. Change freely; only the host side is affected.
POSTGRES_PORT=5442
REDIS_PORT=6389
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
WEB_PORT=3000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=dye
POSTGRES_PASSWORD=dye_dev_password_change_me
POSTGRES_DB=dye_lms

# Used by the host (npm run db:*). Matches POSTGRES_PORT above.
DATABASE_URL=postgresql://dye:dye_dev_password_change_me@localhost:5442/dye_lms?schema=public
# Used from inside the compose network (service name, internal port).
DATABASE_URL_DOCKER=postgresql://dye:dye_dev_password_change_me@postgres:5432/dye_lms?schema=public

# ── Redis (BullMQ queues + rate limiting) ────────────────────────────────────
REDIS_URL=redis://localhost:6389
REDIS_URL_DOCKER=redis://redis:6379

# ── MinIO / S3 (Pygame project assets, pygbag build artifacts) ───────────────
S3_ENDPOINT=http://localhost:9010
S3_ENDPOINT_DOCKER=http://minio:9000
S3_ACCESS_KEY=dye_minio_admin
S3_SECRET_KEY=dye_minio_dev_password_change_me
S3_BUCKET=dye-projects
S3_REGION=us-east-1

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace_me_with_a_32_byte_base64_secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── Seed ─────────────────────────────────────────────────────────────────────
# Password given to every demo account. Development only.
SEED_DEMO_PASSWORD=DyeLms#2026
# The seed refuses to run when NODE_ENV=production unless this is exactly "yes".
SEED_ALLOW_PRODUCTION=no

# ── Judge engine ─────────────────────────────────────────────────────────────
JUDGE_CONCURRENCY=4
JUDGE_MAX_PER_STUDENT=1
JUDGE_DEFAULT_TIME_LIMIT_MS=2000
JUDGE_DEFAULT_MEMORY_LIMIT_MB=256
JUDGE_OUTPUT_LIMIT_BYTES=262144
# Feature flag: pygbag/WASM browser preview for Pygame projects.
# Off by default — Project Upload + teacher review is the primary path.
FEATURE_PYGBAG_PREVIEW=false
