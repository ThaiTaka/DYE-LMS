# ─────────────────────────────────────────────────────────────────────────────
# DYE LMS — mẫu biến môi trường cho MÁY CHỦ THẬT
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Tệp này chứa mật khẩu thật. TUYỆT ĐỐI không commit lên Git.
# Xem hướng dẫn đầy đủ: docs/DEPLOYMENT_GUIDE.md
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Không mở cổng ra ngoài. Chỉ các container trong mạng nội bộ truy cập được.
POSTGRES_USER=dye
# Sinh mật khẩu: openssl rand -base64 24
POSTGRES_PASSWORD=THAY_BANG_MAT_KHAU_NGAU_NHIEN
POSTGRES_DB=dye_lms

# Tên máy chủ là "postgres" (tên service trong compose), cổng nội bộ 5432.
# Mật khẩu ở đây phải TRÙNG KHỚP với POSTGRES_PASSWORD ở trên.
DATABASE_URL=postgresql://dye:THAY_BANG_MAT_KHAU_NGAU_NHIEN@postgres:5432/dye_lms?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
# openssl rand -base64 24
REDIS_PASSWORD=THAY_BANG_MAT_KHAU_NGAU_NHIEN_KHAC
# Mật khẩu phải trùng khớp với REDIS_PASSWORD ở trên.
REDIS_URL=redis://:THAY_BANG_MAT_KHAU_NGAU_NHIEN_KHAC@redis:6379

# ── Auth.js ──────────────────────────────────────────────────────────────────
# BẮT BUỘC. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Đổi giá trị này sẽ vô hiệu hoá toàn bộ phiên đăng nhập đang mở.
AUTH_SECRET=THAY_BANG_CHUOI_BASE64_32_BYTE

# BẮT BUỘC. Phải là https:// và đúng tên miền thật, kể cả khi Nginx đứng trước.
# Sai giá trị này thì đăng nhập sẽ chuyển hướng về sai địa chỉ.
# Optional. Safe to set ONLY when the hostname is fixed — a real domain behind
# Nginx. It overrides host detection entirely, so never point it at a Cloudflare
# quick tunnel or any hostname that changes; leave it commented out instead and
# the origin is read from the request.
AUTH_URL=https://lms.truonghoccuaban.edu.vn

# Ứng dụng chạy sau Nginx nên phải tin tưởng header X-Forwarded-*.
AUTH_TRUST_HOST=true

# ── Cổng nội bộ ──────────────────────────────────────────────────────────────
# Chỉ lắng nghe trên 127.0.0.1. Nginx proxy vào cổng này.
WEB_PORT=3000

# ── Seed ─────────────────────────────────────────────────────────────────────
# Với NODE_ENV=production, seed chỉ nạp chương trình học và huy hiệu,
# KHÔNG tạo tài khoản demo (vì mật khẩu demo được ghi công khai trong repo).
# Tạo tài khoản quản trị đầu tiên bằng: npm run db:admin
#
# Chỉ đặt "yes" trên máy staging nếu thực sự muốn có dữ liệu demo.
SEED_ALLOW_PRODUCTION=no

# ── Bộ chấm bài (judge worker) ───────────────────────────────────────────────
JUDGE_CONCURRENCY=4
# Trần cứng: dù dữ liệu bài tập khai báo bao nhiêu, worker cũng không vượt quá.
JUDGE_MAX_MEMORY_MB=256
JUDGE_MAX_TIME_MS=10000
JUDGE_OUTPUT_LIMIT_BYTES=262144

# ── Tài khoản quản trị ───────────────────────────────────────────────────────
# Dùng bởi `npm run db:admin`. Seed ở chế độ production không tạo tài khoản nào,
# nên đây là cách duy nhất để đăng nhập lần đầu.
#
# Tên đăng nhập luôn được lưu ở dạng chữ thường vì trang đăng nhập tự hạ chữ
# trước khi tra cứu; gõ hoa hay thường lúc đăng nhập đều được.
ADMIN_USERNAME=ThaiTaka
ADMIN_DISPLAY_NAME=Quản Trị Viên
# Ít nhất 12 ký tự. KHÔNG dùng lại mật khẩu ở máy cá nhân.
ADMIN_PASSWORD=THAY_BANG_MAT_KHAU_QUAN_TRI_MANH
